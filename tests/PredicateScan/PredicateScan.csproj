<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Executable coverage for the intent-predicate scanner in
    ../../McpMod.Predicates.cs. It compiles the real scanner sources against
    stand-ins for the game types, then runs them over lambdas written in the
    same shapes the decompiled monsters use. That checks the one thing reading
    the code cannot: how Roslyn actually lowers each predicate to IL.

    Run with: dotnet run (project tests/PredicateScan). Exits non-zero on any
    mismatch. Not part of build.ps1 or the solution — it needs no game DLLs.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>PredicateScanTests</AssemblyName>
    <RootNamespace>STS2_MCP.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\McpMod.Il.cs" />
    <Compile Include="..\..\McpMod.Predicates.cs" />
    <Compile Include="..\..\McpMod.MoveEffects.cs" />
    <Compile Include="MoveEffectStubs.cs" />
    <Compile Include="MoveEffectCases.cs" />
    <Compile Include="MoveEffectChecks.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
